		{
			"name": "[concat(parameters('factoryName'), '/df_calificaciones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "calificaciones_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "calificaciones_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "limpiezaCalificaciones"
						},
						{
							"name": "Valido"
						}
					],
					"scriptLines": [
						"source(output(",
						"          calificacion_id as string,",
						"          pedido_id as string,",
						"          cliente_id as string,",
						"          fecha_calificacion as string,",
						"          puntuacion as string,",
						"          comentario as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(puntuacion = toInteger(puntuacion),",
						"          comentario = iif(isNull(comentario) || length(trim(comentario)) == 0, \"Sin comentario\", trim(comentario)),",
						"          fecha_calificacion = toDate(fecha_calificacion, 'yyyy-MM-dd')) ~> limpiezaCalificaciones",
						"limpiezaCalificaciones split(toInteger(puntuacion) >= 1 && toInteger(puntuacion) <= 5,",
						"     disjoint: false) ~> Valido@(validos, rechazados)",
						"Valido@validos sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          calificacion_id as string,",
						"          pedido_id as string,",
						"          cliente_id as string,",
						"          fecha_calificacion as date,",
						"          puntuacion as integer,",
						"          comentario as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          calificacion_id,",
						"          pedido_id,",
						"          cliente_id,",
						"          fecha_calificacion,",
						"          puntuacion,",
						"          comentario",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_restaurantes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "restaurantes_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "restaurantes_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          restaurante_id as string,",
						"          nombre_restaurante as string,",
						"          tipo_cocina as string,",
						"          calificacion_promedio as string,",
						"          activo as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(restaurante_id = trim(restaurante_id),",
						"          nombre_restaurante = trim(nombre_restaurante),",
						"          tipo_cocina = trim(tipo_cocina),",
						"          calificacion_promedio = toDecimal(calificacion_promedio, 3, 1),",
						"          activo = lower(trim(activo))) ~> derivedColumn1",
						"derivedColumn1 split(calificacion_promedio >= 0 && calificacion_promedio <= 5 && (activo == \"sí\" || activo == \"no\") && length(trim(nombre_restaurante)) > 0,",
						"     disjoint: false) ~> split1@(validos, rechazados)",
						"split1@validos derive(activo = iif(activo == \"sí\", true(), false())) ~> derivedColumn2",
						"derivedColumn2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          restaurante_id as string,",
						"          nombre_restaurante as string,",
						"          tipo_cocina as string,",
						"          calificacion_promedio as decimal(3,1),",
						"          activo as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          restaurante_id,",
						"          nombre_restaurante,",
						"          tipo_cocina,",
						"          calificacion_promedio,",
						"          activo",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/restaurantes_csv')]",
				"[concat(variables('factoryId'), '/datasets/restaurantes_sql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_sucursales')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "sucursales_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "restaurantes_csv",
								"type": "DatasetReference"
							},
							"name": "source2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sucursales_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "limpiezaSucursales"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "split1"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          sucursal_id as string,",
						"          restaurante_id as string,",
						"          nombre_sucursal as string,",
						"          ciudad as string,",
						"          zona as string,",
						"          direccion as string,",
						"          capacidad_mesas as string,",
						"          tiene_delivery as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source(output(",
						"          restaurante_id as string,",
						"          nombre_restaurante as string,",
						"          tipo_cocina as string,",
						"          calificacion_promedio as string,",
						"          activo as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source2",
						"source1 derive(sucursal_id = trim(sucursal_id),",
						"          restaurante_id = trim(restaurante_id),",
						"          nombre_sucursal = initCap(lower(trim(nombre_sucursal))),",
						"          ciudad = initCap(lower(trim(ciudad))),",
						"          zona = initCap(lower(trim(zona))),",
						"          direccion = trim(direccion),",
						"          capacidad_mesas = toInteger(capacidad_mesas),",
						"          tiene_delivery = upper(trim(tiene_delivery))) ~> limpiezaSucursales",
						"limpiezaSucursales, source2 lookup(limpiezaSucursales@restaurante_id == source2@restaurante_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 split(!isNull(capacidad_mesas) && length(trim(nombre_sucursal))>0 && (tiene_delivery==\"SÍ\" || tiene_delivery==\"NO\") && !isNull(nombre_restaurante),",
						"     disjoint: false) ~> split1@(validos, rachazados)",
						"split1@validos derive(tiene_delivery = iif(tiene_delivery==\"SÍ\", true(), false())) ~> derivedColumn1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          sucursal_id as string,",
						"          restaurante_id as string,",
						"          nombre_sucursal as string,",
						"          ciudad as string,",
						"          zona as string,",
						"          direccion as string,",
						"          capacidad_mesas as integer,",
						"          tiene_delivery as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/sucursales_csv')]",
				"[concat(variables('factoryId'), '/datasets/restaurantes_csv')]",
				"[concat(variables('factoryId'), '/datasets/sucursales_sql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_clientes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "clientes_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "clientes_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "limpiezaClientes"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "split1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as string,",
						"          segmento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(cliente_id = trim(cliente_id),",
						"          nombre = initCap(lower(trim(nombre))),",
						"          ciudad = initCap(lower(trim(ciudad))),",
						"          segmento = initCap(lower(trim(segmento))),",
						"          email = trim(email),",
						"          fecha_registro = toDate(fecha_registro,'yyyy-MM-dd'),",
						"          telefono = trim(telefono)) ~> limpiezaClientes",
						"split1@validos aggregate(groupBy(cliente_id),",
						"     nombre = first(nombre),",
						"          email = first(email),",
						"          telefono = first(telefono),",
						"          ciudad = first(ciudad),",
						"          fecha_registro = first(fecha_registro),",
						"          segmento = first(segmento)) ~> aggregate1",
						"limpiezaClientes split(!isNull(cliente_id) && !isNull(nombre) && !isNull(email) && !isNull(ciudad) && email != '',",
						"     disjoint: false) ~> split1@(validos, rechazados)",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as date,",
						"          segmento as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          cliente_id,",
						"          nombre,",
						"          email,",
						"          telefono,",
						"          ciudad,",
						"          fecha_registro,",
						"          segmento",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		}
	]
}