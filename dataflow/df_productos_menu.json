{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(producto_id = trim(producto_id),",
				"          nombre_producto = initCap(lower(trim(nombre_producto))),",
				"          categoria = initCap(lower(trim(categoria))),",
				"          precio_lista = toFloat(trim(replace(precio_lista,'Bs',''))) ,",
				"          costo_estimado = toFloat(trim(costo_estimado)),",
				"          disponible = initCap(lower(trim(disponible)))) ~> derivedColumn1",
				"derivedColumn1 derive(producto_id = iif(producto_id=='PRO0089' && nombre_producto=='Pizza Picante 90', 'PRO0090', producto_id)) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(categoria) && length(trim(categoria))>0 && !isNull(precio_lista) && precio_lista>0 ,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(disponible = iif(lower(trim(disponible))=='sí', true(), false())) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista,",
				"          costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}