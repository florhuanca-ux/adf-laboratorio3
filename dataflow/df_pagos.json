{
	"name": "df_pagos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pagos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pagos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as string,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as date,",
				"          hora_pedido as timestamp,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as decimal(12,2),",
				"          costo_delivery as decimal(12,2),",
				"          descuento as decimal(12,2),",
				"          impuesto as decimal(12,2),",
				"          total_pedido as decimal(12,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(pago_id = trim(pago_id),",
				"          pedido_id = trim(pedido_id),",
				"          fecha_pago = toDate(fecha_pago,'yyyy-MM-dd'),",
				"          metodo_pago = iif(lower(trim(metodo_pago))=='wallet','Billetera móvil',trim(metodo_pago)),",
				"          estado_pago = iif(isNull(estado_pago) || length(trim(estado_pago))==0,'Desconocido',trim(estado_pago)),",
				"          monto_pagado = toDecimal(monto_pagado,12,2)) ~> derivedColumn1",
				"derivedColumn1, source2 lookup(derivedColumn1@pedido_id == source2@pedido_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(monto_pagado >= 0 && !isNull(fecha_pedido),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as date,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pago_id,",
				"          pedido_id = split1@validos@pedido_id,",
				"          fecha_pago,",
				"          metodo_pago,",
				"          estado_pago,",
				"          monto_pagado",
				"     )) ~> sink1"
			]
		}
	}
}