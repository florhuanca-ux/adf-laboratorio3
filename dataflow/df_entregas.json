{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as date,",
				"          hora_pedido as timestamp,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as decimal(12,2),",
				"          costo_delivery as decimal(12,2),",
				"          descuento as decimal(12,2),",
				"          impuesto as decimal(12,2),",
				"          total_pedido as decimal(12,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source1 derive(entrega_id = trim(entrega_id),",
				"          pedido_id = trim(pedido_id),",
				"          repartidor_id = trim(repartidor_id),",
				"          hora_salida = toTimestamp(hora_salida,'yyyy-MM-dd HH:mm:ss'),",
				"          hora_entrega = toTimestamp(hora_entrega,'yyyy-MM-dd HH:mm:ss'),",
				"          tiempo_entrega_min = toInteger(tiempo_entrega_min),",
				"          distancia_km = toDecimal(distancia_km,6,2),",
				"          estado_entrega = trim(estado_entrega)) ~> derivedColumn1",
				"lookup2, source2 lookup(derivedColumn1@pedido_id == source2@pedido_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"derivedColumn1, source3 lookup(derivedColumn1@repartidor_id == source3@repartidor_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup1 split((isNull(tiempo_entrega_min) || tiempo_entrega_min >= 0) && !isNull(fecha_pedido) && !isNull(nombre_repartidor),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as timestamp,",
				"          hora_entrega as timestamp,",
				"          tiempo_entrega_min as integer,",
				"          distancia_km as decimal(6,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id = split1@validos@pedido_id,",
				"          repartidor_id = split1@validos@repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}